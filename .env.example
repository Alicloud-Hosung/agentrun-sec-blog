# Local-only settings for the AgentRun MCP Tool Hook demo. NEVER commit .env.
# Least-privilege RAM user (Function Compute only), created just for this demo.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_UID=
REGION=ap-southeast-1

# Optional: close the direct path to the ticket server (the FC triggers are anonymous).
# The hook attaches HOOK_UPSTREAM_TOKEN to allowed tool calls; the server checks it.
# Set all four together. See README "Security notes".
HOOK_SHARED_SECRET=
HOOK_UPSTREAM_TOKEN=
MCP_AUTH_TOKEN=
MCP_AUTH_SCOPE=tools/call

# Optional: per-user mode (one shared agent, many users). Your app signs each user in,
# issues a signed session ID and sends it as X-AgentRun-Session-Id. See README
# "Per-user mode" and scripts/session_gateway.py. Keep the secret on the app server
# and the hook only.
HOOK_SESSION_SECRET=
HOOK_USER_SCOPES={"alice": "Acme Corp", "bob": "Globex Inc"}

# Eval harness
TICKET_MCP_URL=
AGENT_URL_USER=
AGENT_URL_ADMIN=
AGENT_API_KEY=
AGENT_MODEL=qwen3.8-max
LAYER=L0
REPEATS=3
